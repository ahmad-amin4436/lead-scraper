# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the template carries no secrets and should be tracked.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# LeadMine data store
#
# `database/Businesses.xlsx` is the application's primary datastore and IS
# tracked. The entries below keep secrets and volatile runtime state out of
# version control.
# ---------------------------------------------------------------------------

# Stores the Google Places API key in plaintext — never commit this.
/database/settings.json

# Runtime state: regenerated on demand, noisy in diffs.
/database/logs.jsonl
/database/search-history.json
/database/exports.json

# Generated export files (the folder itself is kept via .gitkeep).
/database/exports/*
!/database/exports/.gitkeep

# Atomic-write temp files.
/database/*.tmp
/database/**/*.tmp

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ---------------------------------------------------------------------------
# LeadMine data store
#
# `database/Businesses.xlsx` is the application's primary datastore and IS
# tracked, along with the activity log and search history.
# ---------------------------------------------------------------------------

# Stores the Google Places API key in plaintext — never commit this.
/database/settings.json

# Generated export files and their index (the folder is kept via .gitkeep).
/database/exports.json
/database/exports/*
!/database/exports/.gitkeep

# Atomic-write temp files.
/database/*.tmp
/database/**/*.tmp

# Migration safety backups.
/database/*.bak-*

# Job state is transient runtime data, recreated per run.
/database/jobs/

# .NET build output
backend/**/bin/
backend/**/obj/

# Visual Studio
backend/.vs/
**/*.csproj.user
**/*.pubxml.user

# Playwright browser downloads (hundreds of MB, redownloaded on first use)
# and runtime-generated state — never commit a live LinkedIn session, it is
# equivalent to a password. See backend/tools/LinkedInLogin/Program.cs.
backend/**/App_Data/


# ---------------------------------------------------------------------------
# LeadMine AI — environment configuration
# Copy to `.env.local` and fill in. Every value is optional; the app runs
# without any of them using OpenStreetMap as the data source.
# ---------------------------------------------------------------------------

# Google Places API key.
# Unlocks ratings, review counts, phone numbers and richer address data.
# Requires the "Places API (New)" and "Geocoding API" enabled on the project.
# When set here it takes precedence over the key stored in Settings and the
# in-app field becomes read-only.
GOOGLE_PLACES_API_KEY=

# Where the Excel database, settings, logs and exports are written.
# Relative paths resolve against the project root. Defaults to ./database
# (or the OS temp directory when a serverless platform is detected).
# On a container or VPS, point this at a mounted persistent volume.
LEADMINE_DATA_DIR=./database

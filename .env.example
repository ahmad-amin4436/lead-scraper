# ---------------------------------------------------------------------------
# LeadMine AI — environment configuration
# Copy to `.env.local` and fill in. Every value is optional; the app runs
# without any of them using OpenStreetMap as the data source.
# ---------------------------------------------------------------------------

# Google Places API key, for the front end's provider-readiness display only.
#
# The scraper runs inside the .NET API and reads its own key from
# `Scraper:GoogleApiKey` there — set that too, or searching stays on
# OpenStreetMap no matter what this says:
#
#   dotnet user-secrets set "Scraper:GoogleApiKey" "<key>" --project src/LeadMine.Api
#   # or, in production:  Scraper__GoogleApiKey=<key>
#
# Requires "Places API (New)" enabled on the Google Cloud project. Enabling
# "Geocoding API" as well is optional but recommended: without it, resolving
# cities falls back to Nominatim, which allows only 1 request per second.
GOOGLE_PLACES_API_KEY=

# Where the Excel database, settings, logs and exports are written.
# Relative paths resolve against the project root. Defaults to ./database
# (or the OS temp directory when a serverless platform is detected).
# On a container or VPS, point this at a mounted persistent volume.
LEADMINE_DATA_DIR=./database

# ---------------------------------------------------------------------------
# .NET 8 backend (LeadMine.Api) integration
# ---------------------------------------------------------------------------

# Base URL of the LeadMine API the server-side proxy forwards to.
# When unset it defaults to http://localhost:5016 in development and
# https://devnet.khaneazam.com in production.
# Note: on a serverless host, the proxy needs a URL the server can reach — a
# public endpoint, not "localhost".
LEADMINE_API_URL=

# ---------------------------------------------------------------------------
# Scraper -> database
# ---------------------------------------------------------------------------

# Shared secret the background scraper uses to save leads into SQL Server via
# the API ingest endpoint. Must match ServiceKey in the backend configuration.
# Without it the scraper falls back to local storage and logs a warning.
LEADMINE_SERVICE_KEY=
